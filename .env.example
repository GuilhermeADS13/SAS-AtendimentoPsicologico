# SAS — Atendimento Psicológico — exemplo de configuração.
# Copie para .env (Docker) ou .env.local (dev) e preencha os valores reais.

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Banco de dados (Supabase / Postgres) ──────────────────────────────────────
# Use o pooler de TRANSAÇÕES do Supabase (porta 6543) — o driver postgres-js roda
# com prepare:false por causa dele. Pegue a string em:
#   Supabase → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgresql://postgres.<project>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Segredo de sessão ─────────────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-secreta-forte

# Login de DESENVOLVIMENTO (só local, NUNCA em produção): quando true e
# NODE_ENV=development, entra automaticamente como um terapeuta de teste,
# permitindo usar os fluxos protegidos sem configurar login real.
DEV_AUTH=false

# ── Supabase Auth (login real) ────────────────────────────────────────────────
# Frontend (embutidas no bundle): URL do projeto e a publishable key (pública).
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend: valida o JWT via JWKS do projeto (não precisa de segredo). Requer as
# signing keys ASSIMÉTRICAS habilitadas no Supabase (Settings → JWT Keys).
SUPABASE_URL=https://<project>.supabase.co
# Opcional (derivado de SUPABASE_URL se omitido):
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ── Videochamada: WebRTC próprio (PADRÃO — P2P, grátis, sem cartão nem conta) ──
# O vídeo é peer-to-peer entre terapeuta e paciente; o servidor só repassa o
# handshake (/api/ws/rtc). NAT é atravessado por STUN grátis do Google, embutido
# no código — nada a configurar.
#
# TURN (opcional, recomendado): cobre as redes onde o P2P NÃO conecta (NAT
# simétrico, firewall corporativo, algumas operadoras móveis). Sem ele, essas
# pessoas ficam presas em "Conectando...". A Metered tem plano grátis de 500MB/mês
# sem cartão (metered.ca) — o TURN só consome quando o P2P falha.
#
# SEGREDO: estas variáveis NÃO levam prefixo VITE_ de propósito. Tudo que é VITE_
# vai embutido no bundle e fica visível para qualquer visitante; a própria Metered
# avisa para nunca expor a chave no front-end. O servidor busca credenciais
# TEMPORÁRIAS e as entrega ao cliente na hora da chamada (ver server/turn.ts).
METERED_DOMAIN=            # ex.: suaclinica.metered.live
METERED_API_KEY=           # "API Key" do painel da Metered — SEGREDO, só no Render
# Região do relay: DEIXE VAZIA. Usando a API com a chave da credencial, a Metered
# já devolve a região configurada no painel, cujo padrão é "Global (automático)" —
# ela roteia para o servidor mais próximo do usuário. Não existe região da América
# do Sul, então o automático é o melhor caso para o Brasil. Preencher aqui
# SOBRESCREVE esse automático por uma região fixa.
METERED_REGION=


# ── Lembretes por e-mail (SMTP) ───────────────────────────────────────────────
# Ative o agendador (roda o ciclo a cada 15 min). Sem SMTP, fica em dry-run (loga).
NOTIFICATIONS_ENABLED=false
# Recebe o aviso quando alguém solicita acesso como psicóloga.
# Se vazio, usa o e-mail do usuário com papel `admin`.
ADMIN_EMAIL=
# Aviso no celular pelo Telegram para o mesmo pedido (opcional). Crie o bot no
# @BotFather; o chat ID sai de api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#
# Gmail: use uma SENHA DE APP (16 caracteres), não a senha da conta.
# Requer verificação em 2 etapas ligada → myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu@gmail.com
#   SMTP_PASS=<senha de app>
#   SMTP_FROM=seu@gmail.com     (o Gmail exige que o From seja a própria conta)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Luma / Agente de IA (LLM open source) ─────────────────────────────────────
# O app NÃO roda o modelo; chama uma API OpenAI-compatible. Em produção (Render)
# precisa ser HOSPEDADA — um Ollama no seu PC (localhost) a nuvem não alcança.
# Variáveis de BACKEND (NUNCA prefixo VITE_). Setar no painel do Render.
#
# ── LUMA: Groq (groq.com), nível gratuito, sem cartão ──────────────────────────
# Desde 2026-10-28 a Luma não lê prontuários nem documentos (só a estrutura do
# prontuário e a agenda): não há embeddings nem indexação.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=              # chave do Groq — SEGREDO; no Render, não no Git
LLM_MODEL=openai/gpt-oss-120b   # a Groq REMOVEU os llama-3.x; modelo morto = 404 "model does not exist"
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
#
# ── FAILOVER (opcional, recomendado): backups quando o principal fica sem cota ──
# O Groq free são ~8000 tokens/min: uma ação pesada da Luma clínica (cancelar, que
# lista consultas e depois propõe) já chega perto. Configure 1+ backups e, no
# 429/queda, o agente cai para o próximo — cada um com sua cota. Para a Luma
# CLÍNICA o backup precisa suportar function calling. Numerados _1_.._5_, tentados
# em ordem. Deixe em branco para não usar.
# Segunda conta Groq (mesmo endpoint/modelo do principal; a cota de 8000 TPM é por
# chave, então uma 2ª chave dá folga fresca no 429). SEM cartão:
LLM_FALLBACK_1_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_1_API_KEY=   # chave de uma 2ª conta Groq — SEGREDO; no Render, não no Git
LLM_FALLBACK_1_MODEL=openai/gpt-oss-120b
# TERCEIRA conta Groq (mesmo esquema). ATENCAO ao nome: o provedor so entra se as
# TRES existirem — faltando uma, ele e ignorado EM SILENCIO, sem erro.
LLM_FALLBACK_2_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_2=           # chave de uma 3a conta Groq — SEGREDO; no Render, nao no Git
#                         (o codigo tambem aceita LLM_FALLBACK_2_API_KEY, que tem precedencia)
LLM_FALLBACK_2_MODEL=openai/gpt-oss-120b
# (opcional) outro provedor em _3_: LLM_FALLBACK_3_BASE_URL=https://openrouter.ai/api/v1
#
AI_AGENT_ENABLED=true     # false = desliga a Luma na hora (kill switch)
# As duas juntas ligam as ferramentas da agenda (o nome AI_RAG_ENABLED é histórico).
AI_RAG_ENABLED=false
AI_CLINICAL_TOOLS_ENABLED=false
#
# Protege /metrics (sem este token, /metrics responde 404):
PROMETHEUS_METRICS_TOKEN=

# ── ALTERNATIVA LOCAL (Ollama/vLLM/LM Studio/LiteLLM) ─────────────────────────
# COMENTADO DE PROPOSITO. Estas variaveis tem os MESMOS nomes das do bloco Groq
# la em cima: se as duas ficarem ativas, quem copiar este arquivo inteiro para um
# .env fica com a ultima valendo — o app ignora o Groq e tenta localhost:11434.
# Para rodar local, comente o bloco Groq e descomente este.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=800
# Nunca exponha esta chave com prefixo VITE_; ela só pode existir no backend.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Observabilidade Prometheus/Grafana ─────────────────────────────────────────
PROMETHEUS_METRICS_TOKEN=change-me-in-production

# ── Cache de respostas (manter desabilitado até validar retenção clínica) ─────
AI_RESPONSE_CACHE_ENABLED=false
AI_RESPONSE_CACHE_TTL_SECONDS=60
AI_RESPONSE_CACHE_MAX_ENTRIES=500
AI_CACHE_VERSION=1

# ── Otimização de contexto e custo do agente ──────────────────────────────────
AI_AGENT_MAX_HISTORY_MESSAGES=8
AI_AGENT_MAX_MESSAGE_CHARS=4000
AI_AGENT_MAX_CONTEXT_CHARS=12000
AI_AGENT_ENABLED=true
AI_RAG_ENABLED=true
AI_CLINICAL_TOOLS_ENABLED=true
AI_DLP_TELEMETRY_ENABLED=true
# Validade do código de confirmação das ações de escrita da Luma (agendar,
# remarcar, cancelar, pagamento). O código é emitido pelo servidor na primeira
# chamada da ferramenta e só vale na rodada seguinte da conversa — é o que
# impede o modelo de propor e confirmar sozinho. Ver server/ai/action-confirmation.ts.
AI_ACTION_CONFIRMATION_TTL_SECONDS=900
