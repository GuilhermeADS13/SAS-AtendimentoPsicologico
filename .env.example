# SAS — Atendimento Psicológico — exemplo de configuração.
# Copie para .env (Docker) ou .env.local (dev) e preencha os valores reais.

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Banco de dados (Supabase / Postgres) ──────────────────────────────────────
# Use o pooler de TRANSAÇÕES do Supabase (porta 6543) — o driver postgres-js roda
# com prepare:false por causa dele. Pegue a string em:
#   Supabase → Project Settings → Database → Connection string → "Transaction pooler".
DATABASE_URL=postgresql://postgres.<project>:<senha>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Autenticação (OAuth Manus) ────────────────────────────────────────────────
JWT_SECRET=troque-por-uma-chave-secreta-forte
VITE_APP_ID=seu-app-id-manus
OAUTH_SERVER_URL=https://api.manus.im

# Login de DESENVOLVIMENTO (só local, NUNCA em produção): quando true e
# NODE_ENV=development, entra automaticamente como um terapeuta de teste,
# permitindo usar os fluxos protegidos sem configurar o OAuth.
DEV_AUTH=false

# ── Supabase Auth (login real) ────────────────────────────────────────────────
# Frontend (embutidas no bundle): URL do projeto e a publishable key (pública).
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Backend: valida o JWT via JWKS do projeto (não precisa de segredo). Requer as
# signing keys ASSIMÉTRICAS habilitadas no Supabase (Settings → JWT Keys).
SUPABASE_URL=https://<project>.supabase.co
# Opcional (derivado de SUPABASE_URL se omitido):
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ── Videochamada (MiroTalk SFU) ───────────────────────────────────────────────
# Padrão: instância pública do MiroTalk (não precisa hospedar nada).
# Para self-host (gravação própria), suba via Docker e use https://localhost:3010.
VITE_MIROTALK_URL=https://sfu.mirotalk.com

# ── Lembretes por e-mail (SMTP) ───────────────────────────────────────────────
# Ative o agendador (roda o ciclo a cada 15 min). Sem SMTP, fica em dry-run (loga).
NOTIFICATIONS_ENABLED=false
# Recebe o aviso quando alguém solicita acesso como psicóloga.
# Se vazio, usa o e-mail do usuário com papel `admin`.
ADMIN_EMAIL=
#
# Gmail: use uma SENHA DE APP (16 caracteres), não a senha da conta.
# Requer verificação em 2 etapas ligada → myaccount.google.com/apppasswords
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seu@gmail.com
#   SMTP_PASS=<senha de app>
#   SMTP_FROM=seu@gmail.com     (o Gmail exige que o From seja a própria conta)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Luma / Agente de IA (LLM open source) ─────────────────────────────────────
# O app NÃO roda o modelo; chama uma API OpenAI-compatible. Em produção (Render)
# precisa ser HOSPEDADA — um Ollama no seu PC (localhost) a nuvem não alcança.
# Variáveis de BACKEND (NUNCA prefixo VITE_). Setar no painel do Render.
#
# ── OPÇÃO A — CUSTO ZERO (recomendada p/ começar): Groq + RAG desligado ────────
# Groq (groq.com) tem nível gratuito, sem cartão, com modelo open source (Llama).
# Desligando o RAG de documentos, o agente não usa embeddings — a única parte que
# teria custo. A Luma vira um assistente de "como usar o sistema" (o objetivo
# principal). Perde-se só a leitura de prontuário ao vivo / busca em documentos.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=              # chave do Groq — SEGREDO; no Render, não no Git
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
AI_AGENT_ENABLED=true     # false = desliga a Luma na hora (kill switch)
AI_RAG_ENABLED=false      # false = sem embeddings/leitura de prontuário (grátis)
AI_CLINICAL_TOOLS_ENABLED=false
#
# ── OPÇÃO B — RAG CLÍNICO COMPLETO (tem custo): provedor com embeddings ────────
# Para a Luma LER prontuário e buscar em documentos, precisa de embeddings 768d
# (coluna vector(768)). Groq não serve embeddings; use um provedor que faça
# chat+embeddings na mesma conta (ex.: Together AI / DeepInfra — têm custo por
# uso). Aí troque as de cima por:
#   LLM_BASE_URL=https://api.together.xyz/v1
#   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#   LLM_EMBEDDING_BASE_URL=https://api.together.xyz/v1
#   LLM_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval  # confirme 768 dims
#   AI_RAG_ENABLED=true
#   AI_CLINICAL_TOOLS_ENABLED=true
#   SUPABASE_SERVICE_ROLE_KEY=   # SEGREDO (Supabase → Settings → API → service_role); RAG baixa o doc privado
AI_OCR_MIN_CONFIDENCE=75
# Protege /metrics (sem este token, /metrics responde 404):
PROMETHEUS_METRICS_TOKEN=

# ── LLM open source via API OpenAI-compatible ─────────────────────────────────
# Ollama, vLLM, LM Studio ou LiteLLM. Nunca exponha LLM_API_KEY no frontend.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_EMBEDDING_BASE_URL=http://localhost:11434/v1
LLM_EMBEDDING_MODEL=nomic-embed-text
# Nunca exponha esta chave com prefixo VITE_; ela só pode existir no backend.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
AI_EMBEDDING_DIMENSIONS=768
AI_WORKER_POLL_INTERVAL_MS=3000
AI_WORKER_ONCE=0
AI_WORKER_METRICS_INTERVAL_MS=60000
AI_QUEUE_ALERT_MAX_AGE_SECONDS=900
AI_QUEUE_ALERT_MAX_FAILED=3

# ── Observabilidade Prometheus/Grafana ─────────────────────────────────────────
PROMETHEUS_METRICS_TOKEN=change-me-in-production

# ── Cache de respostas (manter desabilitado até validar retenção clínica) ─────
AI_RESPONSE_CACHE_ENABLED=false
AI_RESPONSE_CACHE_TTL_SECONDS=60
AI_RESPONSE_CACHE_MAX_ENTRIES=500
AI_CACHE_VERSION=1

# ── Otimização de contexto e custo do agente ──────────────────────────────────
AI_AGENT_MAX_HISTORY_MESSAGES=8
AI_AGENT_MAX_MESSAGE_CHARS=4000
AI_AGENT_MAX_CONTEXT_CHARS=12000
AI_RAG_TOP_K=6
AI_RAG_MAX_TOP_K=8
AI_RAG_CONTEXT_MAX_CHARS=8000
AI_AGENT_ENABLED=true
AI_RAG_ENABLED=true
AI_CLINICAL_TOOLS_ENABLED=true
AI_OCR_MIN_CONFIDENCE=75
AI_DLP_TELEMETRY_ENABLED=true
AI_RAG_RERANK_ENABLED=true
