{
  "name": "psicologia-atendimento",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint:invisivel": "tsx scripts/caractereInvisivel.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run server/flow.integration.test.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:migrate:supabase": "bash scripts/apply-supabase-migration.sh",
    "ai:worker": "tsx server/ai/worker.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
